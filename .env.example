# Copy this file to .env (repo root) — docker-compose reads it for variable
# interpolation. Individual services have their own env setup:
#   - web/.env for `next dev` (NEXT_PUBLIC_API_URL, API_URL)
#   - backend reads env vars directly (DJANGO_*, CORS_ORIGINS, DATA_DIR)

# --- Docker Compose (root .env) ---

# Superuser seeded by backend/docker-entrypoint.sh on container start.
# Leave empty to skip superuser creation.
DJANGO_SUPERUSER_MOBILE=
DJANGO_SUPERUSER_PASSWORD=

# --- Backend (Django, backend/config/settings.py) ---

# Secret key — change this for anything beyond local development.
DJANGO_SECRET_KEY=change-me-in-production

# "1"/"true" enables debug mode. Keep "0" in docker-compose.
DJANGO_DEBUG=0

# Path to the SQLite database file.
DJANGO_DB_PATH=/app/db/db.sqlite3

# Comma-separated origins allowed for CORS (also used for CSRF trusted origins).
CORS_ORIGINS=http://localhost:3000

# Comma-separated allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,backend,127.0.0.1

# Directory holding seed JSON data (schemes, questions, ...).
DATA_DIR=/app/data

# "1" wipes and rebuilds the database on container start.
FRESH_DB=1

# --- Web (Next.js, web/.env) ---

# Client-side API base URL — inlined at build time, must be publicly reachable.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side API base URL — read at runtime by server components.
API_URL=http://localhost:8000