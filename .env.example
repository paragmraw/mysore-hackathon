# Copy this file to .env (repo root) — docker-compose reads it for ${VAR}
# interpolation. web/.env carries the browser-facing URL for non-Docker dev.
# Each value appears exactly once in .env; docker-compose.yml is pure wiring.

# --- API URLs (single source of truth) ---

# Browser-facing API base URL. Inlined into the Next.js client bundle at
# build time; must be reachable from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API base URL for web's server-side code. Inside the compose network the
# backend service is reachable at http://backend:8000. For non-Docker dev the
# server code falls back to NEXT_PUBLIC_API_URL, so no separate value needed.
SERVER_API_URL=http://backend:8000

# --- Backend (Django, backend/config/settings.py) ---

# Secret key — change this for anything beyond local development.
DJANGO_SECRET_KEY=change-me-in-production

# DJANGO_DEBUG defaults to true in settings.py; docker-compose pins it to 0.
# Uncomment to override for a local non-Docker run:
# DJANGO_DEBUG=1

# Superuser seeded by backend/docker-entrypoint.sh on container start.
# Leave empty to skip superuser creation.
DJANGO_SUPERUSER_MOBILE=
DJANGO_SUPERUSER_PASSWORD=

# --- CLI (cli/namma_mitra.py) ---

# Optional override for the --api flag's default.
# NAMMA_MITRA_API_URL=http://localhost:8000